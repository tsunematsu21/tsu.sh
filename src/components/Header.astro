---
import Icon from "@assets/icon.svg";
import ThemeIcon from "@components/ThemeIcon.astro";
---

<nav class="py-8">
  <ul class="flex items-center gap-4">
    <li class="flex-grow">
      <a href="/">
        <Icon aria-hidden="true" class="h-5 inline align-text-bottom" />
        <span class="font-bold">tsu.sh</span>
      </a>
    </li>
    <li>
      <a href="/posts">Posts</a>
    </li>
    <li>
      <a href="/works">Works</a>
    </li>
    <li>
      <a
        href="/rss.xml"
        title="RSS feed"
        aria-label="RSS feed"
        class="i-ph-rss-simple-bold"
      />
    </li>
    <li>
      <ThemeIcon />
    </li>
  </ul>
</nav>
