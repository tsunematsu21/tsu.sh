---
---

<div class="py-4 space-y-4">
  <div
    class="flex flex-col md:flex-row items-center justify-between flex-wrap gap-8 py-4"
  >
    <p class="text-sm">
      <span>Made with </span>
      <i class="i-ph-heart-straight" />
      <span> and </span>
      <i class="i-ph-hand-peace" />
      <span>. </span>
      <a href="/thanks" class="underline">Thanks</a>
      <span> for your visiting.</span>
    </p>
    <nav>
      <ul class="flex items-center gap-4">
        <li>
          <a
            href="https://github.com/tsunematsu21"
            target="_blank"
            title="GitHub @tsunematsu21"
          >
            <span class="i-simple-icons-github" />
          </a>
        </li>
        <li>
          <a
            href="https://bsky.app/profile/tsu.sh"
            target="_blank"
            title="BlueSky @tsu.sh"
          >
            <span class="i-simple-icons-bluesky" />
          </a>
        </li>
        <li>
          <a href="/rss.xml" title="RSS Feed">
            <span class="i-simple-icons-rss" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <small class="block text-center text-xs text-muted">
    <span>&copy; Masato Tsunematsu</span>
    <span aria-hidden="true"> · </span>
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      class="underline"
    >
      CC BY-NC-SA 4.0
    </a>
  </small>
</div>
