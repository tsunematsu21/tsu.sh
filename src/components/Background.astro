<style>
.star-background {
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: fixed;
  z-index: 0;
}

.star-background__svg {
  color: rgb(0 0 0 / 18%);
  height: 100%;
  width: 100%;
}

.star-background circle {
  fill: currentColor;
  vector-effect: non-scaling-stroke;
}

.star-background__sky {
  animation: star-drift 120s ease-in-out infinite alternate;
  transform-box: view-box;
  transform-origin: 50% 135%;
}

.star-background__static circle:nth-child(3n + 1) {
  opacity: 0.42;
}

.star-background__static circle:nth-child(3n + 2) {
  opacity: 0.68;
}

.star-background__twinkle {
  animation: star-twinkle linear infinite;
  opacity: 0.35;
}

.star-background__twinkle--one {
  animation-duration: 7s;
}

.star-background__twinkle--two {
  animation-duration: 11s;
}

.star-background__twinkle--three {
  animation-duration: 13s;
}

.star-background__shooting-star {
  animation: shooting-star 87s linear infinite;
  fill: none;
  opacity: 0;
  stroke: currentColor;
  stroke-dasharray: 0.14 0.86;
  stroke-dashoffset: 1;
  stroke-linecap: round;
  stroke-width: 1.5;
  vector-effect: non-scaling-stroke;
}

.star-background__shooting-star--two {
  animation-delay: -29s;
}

.star-background__shooting-star--three {
  animation-delay: -58s;
}

:global(html.dark) .star-background__svg {
  color: rgb(255 255 255 / 24%);
}

@keyframes star-twinkle {
  0%,
  100% {
    opacity: 0.3;
  }

  48% {
    opacity: 0.85;
  }

  62% {
    opacity: 0.5;
  }
}

@keyframes star-drift {
  from {
    transform: rotate(-0.7deg);
  }

  to {
    transform: rotate(0.7deg);
  }
}

@keyframes shooting-star {
  0%,
  24%,
  28%,
  100% {
    opacity: 0;
    stroke-dashoffset: 1;
  }

  25% {
    opacity: 0.75;
  }

  27% {
    opacity: 0;
    stroke-dashoffset: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .star-background__sky,
  .star-background__twinkle,
  .star-background__shooting-star {
    animation: none;
  }
}
</style>

<script is:inline>
const backgroundAnimations = [
  { selector: ".star-background__sky", duration: 120000 },
  { selector: ".star-background__twinkle--one", duration: 7000 },
  { selector: ".star-background__twinkle--two", duration: 11000 },
  { selector: ".star-background__twinkle--three", duration: 13000 },
  { selector: ".star-background__shooting-star--one", duration: 87000 },
  { selector: ".star-background__shooting-star--two", duration: 87000 },
  { selector: ".star-background__shooting-star--three", duration: 87000 },
];

for (const { selector, duration } of backgroundAnimations) {
  const animation = document.querySelector(selector)?.getAnimations()[0];

  if (animation) {
    animation.currentTime = Date.now() % duration;
  }
}
</script>
