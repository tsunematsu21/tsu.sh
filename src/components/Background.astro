---
import ShootingStars from "./ShootingStars.astro";
---

<div class="star-background" aria-hidden="true">
  <!-- biome-ignore lint/a11y/noSvgWithoutTitle: Decorative background hidden from assistive technology. -->
  <svg
    class="star-background__svg"
    viewBox="0 0 1600 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    <g class="star-background__sky">
      <g class="star-background__static">
        <circle cx="74" cy="128" r="1.8" />
        <circle cx="185" cy="62" r="2.6" />
        <circle cx="318" cy="196" r="1.4" />
        <circle cx="438" cy="92" r="2" />
        <circle cx="594" cy="238" r="2.8" />
        <circle cx="716" cy="116" r="1.5" />
        <circle cx="874" cy="54" r="2.3" />
        <circle cx="1018" cy="202" r="1.7" />
        <circle cx="1172" cy="104" r="2.9" />
        <circle cx="1315" cy="242" r="1.6" />
        <circle cx="1488" cy="82" r="2.2" />
        <circle cx="118" cy="368" r="2.5" />
        <circle cx="266" cy="482" r="1.5" />
        <circle cx="392" cy="344" r="2.1" />
        <circle cx="536" cy="512" r="2.7" />
        <circle cx="684" cy="386" r="1.7" />
        <circle cx="834" cy="468" r="2.4" />
        <circle cx="972" cy="328" r="1.4" />
        <circle cx="1126" cy="494" r="2" />
        <circle cx="1278" cy="358" r="2.6" />
        <circle cx="1442" cy="436" r="1.8" />
        <circle cx="52" cy="702" r="2.2" />
        <circle cx="224" cy="824" r="1.7" />
        <circle cx="364" cy="654" r="2.8" />
        <circle cx="522" cy="786" r="1.5" />
        <circle cx="668" cy="906" r="2.4" />
        <circle cx="812" cy="718" r="1.6" />
        <circle cx="958" cy="856" r="2.7" />
        <circle cx="1098" cy="676" r="1.8" />
        <circle cx="1246" cy="814" r="2.2" />
        <circle cx="1394" cy="704" r="1.4" />
        <circle cx="1534" cy="884" r="2.6" />
        <circle cx="286" cy="86" r="1.2" />
        <circle cx="760" cy="176" r="1.1" />
        <circle cx="1370" cy="154" r="1.3" />
        <circle cx="94" cy="544" r="1.2" />
        <circle cx="748" cy="568" r="1.4" />
        <circle cx="1518" cy="638" r="1.1" />
        <circle cx="426" cy="748" r="1.2" />
        <circle cx="1160" cy="842" r="1.3" />
      </g>

      <g class="star-background__twinkle star-background__twinkle--one">
        <circle cx="238" cy="246" r="3.2" />
        <circle cx="1062" cy="612" r="3" />
      </g>
      <g class="star-background__twinkle star-background__twinkle--two">
        <circle cx="768" cy="286" r="2.8" />
        <circle cx="1462" cy="608" r="3.4" />
      </g>
      <g class="star-background__twinkle star-background__twinkle--three">
        <circle cx="448" cy="922" r="3" />
        <circle cx="1218" cy="914" r="2.7" />
      </g>
    </g>
  </svg>
  <ShootingStars />
</div>

<style>
.star-background {
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: fixed;
  z-index: 0;
}

.star-background__svg {
  color: rgb(0 0 0 / 18%);
  filter: blur(0.7px);
  height: 100%;
  transform: scale(1.01);
  width: 100%;
}

.star-background circle {
  fill: currentColor;
  vector-effect: non-scaling-stroke;
}

.star-background__sky {
  animation: star-drift 40s ease-in-out infinite alternate;
  transform-box: view-box;
  transform-origin: 50% 135%;
}

.star-background__static circle:nth-child(3n + 1) {
  opacity: 0.42;
}

.star-background__static circle:nth-child(3n + 2) {
  opacity: 0.68;
}

.star-background__twinkle {
  animation: star-twinkle linear infinite;
  opacity: 0.35;
}

.star-background__twinkle--one {
  animation-duration: 7s;
}

.star-background__twinkle--two {
  animation-duration: 11s;
}

.star-background__twinkle--three {
  animation-duration: 13s;
}

:global(html.dark) .star-background__svg {
  color: rgb(190 205 255 / 30%);
}

@keyframes star-twinkle {
  0%,
  100% {
    opacity: 0.3;
  }

  48% {
    opacity: 0.85;
  }

  62% {
    opacity: 0.5;
  }
}

@keyframes star-drift {
  from {
    transform: translateX(-12px) rotate(-0.4deg);
  }

  to {
    transform: translateX(12px) rotate(0.4deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .star-background__sky,
  .star-background__twinkle {
    animation: none;
  }
}
</style>

<script is:inline>
const backgroundAnimations = [
  { selector: ".star-background__sky", duration: 40000 },
  { selector: ".star-background__twinkle--one", duration: 7000 },
  { selector: ".star-background__twinkle--two", duration: 11000 },
  { selector: ".star-background__twinkle--three", duration: 13000 },
];

for (const { selector, duration } of backgroundAnimations) {
  const animation = document.querySelector(selector)?.getAnimations()[0];

  if (animation) {
    animation.currentTime = Date.now() % duration;
  }
}
</script>
