<div class="prose dark:prose-invert max-w-none">
  <slot />
</div>

<style>
@layer components {
  .prose {
    a.remark-link-card-plus__card {
      @apply grid grid-cols-5 gap-4 w-full outline outline-1 rounded-md no-underline!;
      .remark-link-card-plus__main {
        @apply col-span-3 flex flex-col justify-between p-4 h-full;
        .remark-link-card-plus__content {
          .remark-link-card-plus__title {
            @apply line-clamp-1;
          }
          .remark-link-card-plus__description {
            @apply flex-1 text-xs opacity-50 line-clamp-2 md:line-clamp-4;
          }
        }
        .remark-link-card-plus__meta {
          @apply flex items-center justify-start gap-2;
          .remark-link-card-plus__favicon {
            @apply mb-0! mt-0!;
          }
          .remark-link-card-plus__url {
            @apply text-xs line-clamp-1;
          }
        }
      }
      .remark-link-card-plus__thumbnail {
        @apply col-span-2;
        .remark-link-card-plus__image {
          @apply object-cover object-center m-0! h-full w-full rounded-r-md;
        }
      }
    }
  }
}
</style>
