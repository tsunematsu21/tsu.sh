---
---

<div class="prose dark:prose-invert max-w-none">
  <slot />
</div>

<style>
@layer components {
  .prose {
    .link-card__container {
      @apply my-5 bg-base color-base;
    }

    a.link-card {
      @apply grid grid-cols-5 gap-4 w-full outline outline-1 rounded-md no-underline!;

      .link-card__main {
        @apply col-span-3 flex flex-col justify-between p-4 h-full;

        &.link-card__main--full {
          @apply col-span-5;
        }
      }

      .link-card__title {
        @apply line-clamp-1 font-bold;
      }

      .link-card__description {
        @apply flex-1 text-xs line-clamp-2 md:line-clamp-4;
      }

      .link-card__meta {
        @apply flex items-center justify-start gap-2;
      }

      .link-card__favicon {
        @apply mb-0! mt-0!;
      }

      .link-card__url {
        @apply text-xs line-clamp-1;
      }

      .link-card__thumbnail {
        @apply col-span-2;
      }

      .link-card__image {
        @apply object-cover object-center m-0! h-full! w-full rounded-r-md;
      }
    }
  }
}
</style>
