---
import Background from "@components/Background.astro";
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";

interface Props {
  pageTitle?: string;
  description?: string;
  image?: string;
}

const { pageTitle, description, image } = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead pageTitle={pageTitle} description={description} image={image} />
  </head>
  <body>
    <Background />
    <div
      class="relative z-10 flex flex-col min-h-screen max-w-3xl mx-auto px-8"
    >
      <header>
        <Header />
      </header>
      <main class="flex-grow py-16">
        <slot />
      </main>
      <footer>
        <Footer />
      </footer>
    </div>
  </body>
</html>

<style is:global>
@view-transition {
  navigation: auto;
}

html {
  scrollbar-gutter: stable;
  color-scheme: light;
}

html.dark {
  color-scheme: dark;
}

body {
  font-family: system-ui, sans-serif;
  @apply bg-base color-base;
}

body a {
  @apply hover:opacity-50 transition-all duration-500;
}

main {
  view-transition-name: main;
}

::view-transition-group(main) {
  animation-duration: 600ms;
}

::view-transition-old(main) {
  animation: main-exit 240ms ease-in both;
}

::view-transition-new(main) {
  animation: main-enter 360ms 240ms ease-out both;
}

@keyframes main-exit {
  to {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
}

@keyframes main-enter {
  from {
    opacity: 0;
    transform: translateY(1rem);
  }
}
</style>
