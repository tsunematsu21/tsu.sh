---
import Background from "@components/Background.astro";
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";

interface Props {
  pageTitle?: string;
  description?: string;
  image?: string;
}

const { pageTitle, description, image } = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead pageTitle={pageTitle} description={description} image={image} />
  </head>
  <body>
    <Background />
    <div
      class="relative z-10 flex flex-col min-h-screen max-w-3xl mx-auto px-8"
    >
      <header>
        <Header />
      </header>
      <main class="flex-grow py-16">
        <slot />
      </main>
      <footer>
        <Footer />
      </footer>
    </div>
  </body>
</html>

<style is:global>
@view-transition {
  navigation: auto;
}

@media (prefers-reduced-motion: reduce) {
  @view-transition {
    navigation: none;
  }
}

html {
  scrollbar-gutter: stable;
  color-scheme: light;
}

html.dark {
  color-scheme: dark;
}

body {
  font-family: system-ui, sans-serif;
  @apply bg-base color-base;
}

body a {
  @apply hover:opacity-50 transition-opacity duration-300;
}

main {
  view-transition-name: main;
}

::view-transition-group(main) {
  animation-duration: 600ms;
}

::view-transition-old(main) {
  animation: main-exit 280ms ease-in both;
}

::view-transition-new(main) {
  animation: main-enter 420ms 160ms ease-out both;
}

@keyframes main-exit {
  to {
    opacity: 0;
    filter: blur(0.25rem) brightness(0.82);
  }
}

@keyframes main-enter {
  from {
    opacity: 0;
    filter: blur(0.375rem) brightness(0.9);
  }

  to {
    opacity: 1;
    filter: blur(0) brightness(1);
  }
}
</style>
