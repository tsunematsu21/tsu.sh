---
import { ClientRouter } from "astro:transitions";
import Background from "@components/Background.astro";
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";

interface Props {
  pageTitle?: string;
  description?: string;
  image?: string;
}

const { pageTitle, description, image } = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead pageTitle={pageTitle} description={description} image={image} />
    <ClientRouter />
    <style is:inline>
    html {
      background: #fff;
      color-scheme: light;
    }

    html.dark {
      background: #18181b;
      color-scheme: dark;
    }
    </style>
  </head>
  <body>
    <Background />
    <div
      class="relative z-10 flex flex-col min-h-screen max-w-3xl mx-auto px-8"
    >
      <header>
        <Header />
      </header>
      <main class="flex-grow py-16">
        <slot />
      </main>
      <footer>
        <Footer />
      </footer>
    </div>
  </body>
</html>

<style is:global>
body {
  font-family: system-ui, sans-serif;
  @apply bg-white text-black;
  @apply dark:(bg-zinc-900 text-white);
}

body a {
  @apply hover:opacity-50 transition-all;
}

::view-transition-image-pair(root) {
  isolation: auto;
}

::view-transition-old(root),
::view-transition-new(root) {
  animation: none;
  mix-blend-mode: normal;
}
</style>
